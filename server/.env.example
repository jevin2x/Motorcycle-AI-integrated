# Copy this file to server/.env and add your FREE key from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any free model from https://openrouter.ai/models?free=true works.
# Popular free picks (availability changes, pick whichever is currently free):
#   meta-llama/llama-3.2-3b-instruct:free
#   google/gemini-2.0-flash-exp:free
#   deepseek/deepseek-r1:free
#   qwen/qwen3-235b-a22b:free
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Optional: keyless free AI gateway used when no OpenRouter key is set.
# It already works with the default below — no signup required.
KILO_MODEL=kilo-auto/free
BLOCKRUN_MODEL=nvidia/gpt-oss-120b

PORT=5000
SITE_URL=http://localhost:5173
